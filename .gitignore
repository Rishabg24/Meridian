# Ignore local environment and editor metadata
venv/

# Ignore project artifacts and unwanted files
*.md
*.png
.claude/
tests/

# Keep only web source files in version control
# Allow directories so recursive rules can unignore nested source files.
*
!*/
!*.js
!*.html
!*.css
!**/*.js
!**/*.html
!**/*.css
!.gitignore

# Search-engine and deployment files. These must ship: the deny-all above
# would otherwise leave robots.txt and the sitemap untracked and undeployed,
# which is indistinguishable from never having written them.
!robots.txt
!sitemap.xml
!CNAME

# Brand imagery referenced by <link rel="icon"> and og:image. Named
# individually so the blanket *.png rule keeps ignoring screenshots.
!assets/
!assets/favicon.svg
!assets/icon-192.png
!assets/icon-512.png
!assets/apple-touch-icon.png
!assets/og-cover.png
